package pages

import (
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/templates/layouts"
	"github.com/gin-gonic/gin"
)

templ Categories(c *gin.Context, categories []repository.Category) {
	@layouts.Base(c, "Categories", "categories") {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<div>
					<h1 class="text-2xl font-bold">Categories</h1>
				</div>
				<div class="flex gap-2">
					@components.ButtonLink(routes.CategoryCreateForm.URL(), components.ButtonConfig("Create").
						Icon(icons.Plus()).
						Color("primary"),
					)
				</div>
			</div>
			@CategoriesTable(c, categories, nil)
		</div>
	}
}

templ CreateUpdateCategory(c *gin.Context, category *repository.Category) {
	{{
		title := "Create category"
		formMethod := "post"
		formAction := routes.CategoryCreate.URL()
		submitButtonText := "Create"

		name := ""
		description := ""

		if category != nil {
			title = "Update category: " + category.Name
			formMethod = "put"
			formAction = routes.CategoryUpdate.URLWithReturn(routes.ID(category.ID), c)
			submitButtonText = "Update"

			name = category.Name
			description = category.Description.String
		}
	}}
	@layouts.Base(c, title, "categories") {
		<h1 class="mb-4 text-2xl font-bold">{ title }</h1>
		<form id="category-form" name="category-form" { "hx-" + formMethod }={ formAction } hx-swap="none">
			@components.FormField(components.FormFieldConfig("name").
				Type("text").
				Label("Category name").
				Placeholder("Meals").
				Value(name).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("description").
				Type("textarea").
				Label("Description").
				Placeholder("Category description").
				Value(description).
				Required(),
			)
			<div class="flex justify-end space-x-2">
				@components.ButtonLink(routes.CategoryList.ReturnOrURL(c), components.ButtonConfig("Back").
					Icon(icons.ArrowLeft()).
					Color("neutral"),
				)
				@components.Button(components.ButtonConfig(submitButtonText).
					Type("submit").
					Icon(icons.FloppyDisk()).
					Color("primary"),
				)
			</div>
		</form>
	}
}

templ CategoryDetails(c *gin.Context, category repository.Category, subcategories []repository.SubcategoryWithDetail, products []repository.ProductWithDetail) {
	{{
		safeToDelete := false

		if len(subcategories) == 0 && len(products) == 0 {
			safeToDelete = true
		}
	}}
	@layouts.Base(c, "Category details", "categories") {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<div>
					<h1 class="mb-1 text-2xl font-bold">{ category.Name }</h1>
					<p class="text-base-content/70 text-sm">{ category.Description.String }</p>
				</div>
				<div class="flex gap-2">
					@components.ButtonLink(routes.CategoryList.ReturnOrURL(c), components.ButtonConfig("Back").
						Icon(icons.ArrowLeft()).
						Color("neutral"),
					)
					@components.ButtonLink(routes.SubcategoryCreateForm.URLWithReturnToCurrent(routes.ID(category.ID), c), components.ButtonConfig("Add subcategory").
						Icon(icons.Plus()).
						Color("primary"),
					)
					@components.ButtonLink(routes.CategoryEditForm.URLWithReturnToCurrent(routes.ID(category.ID), c), components.ButtonConfig("Edit").
						Icon(icons.PencilSquare()).
						Color("info"),
					)
					@components.Button(components.ButtonConfig("Delete").
						Icon(icons.Trash()).
						Color("error").
						Disabled(!safeToDelete).
						HxDelete(routes.CategoryDelete.URLWithReturn(routes.ID(category.ID), c)).
						HxConfirm("Are you sure you want to delete this category?").
						HxSwap("none"),
					)
				</div>
			</div>
			@SubcategoriesForCategoryTable(c, category.ID, subcategories, nil)
			@ProductsForCategoryTable(c, category.ID, products, nil)
		</div>
	}
}
