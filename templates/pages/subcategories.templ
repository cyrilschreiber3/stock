package pages

import (
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/locales"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/templates/layouts"
	"github.com/gin-gonic/gin"
	"github.com/invopop/ctxi18n/i18n"
)

templ CreateUpdateSubcategory(c *gin.Context, category repository.Category, subcategory *repository.Subcategory) {
	{{
		l := locales.New(c)

		windowTitle := l.Tc("subcategories.titles.new")
		title := l.Tc("subcategories.titles.new")
		formMethod := "post"
		formAction := routes.SubcategoryCreate.URL(routes.ID(category.ID))
		submitButtonText := l.Tc("actions.create")

		name := ""
		description := ""

		if subcategory != nil {
			windowTitle = l.Tc("subcategories.titles.edit")
			title = l.Tc("subcategories.titles.edit_named", i18n.M{"name": subcategory.Name})
			formMethod = "put"
			formAction = routes.SubcategoryUpdate.URLWithReturn(routes.Subcategory(category.ID, subcategory.ID), c)
			submitButtonText = l.Tc("actions.update")

			name = subcategory.Name
			description = subcategory.Description.String
		}
	}}
	@layouts.Base(c, windowTitle, "categories") {
		<h1 class="mb-1 text-2xl font-bold">{ title }</h1>
		<p class="text-base-content/70 mb-4 text-sm">{ l.Tc("categories.label") }: { category.Name }</p>
		<form id="subcategory-form" name="subcategory-form" { "hx-" + formMethod }={ formAction } hx-swap="none">
			<input type="hidden" name="category_id" value={ category.ID.String() }/>
			@components.FormField(components.FormFieldConfig("name").
				Type("text").
				Label(l.Tc("subcategories.fields.name")).
				Placeholder(l.Tc("subcategories.placeholders.name")).
				Value(name).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("description").
				Type("textarea").
				Label(l.Tc("table.columns.description")).
				Placeholder(l.Tc("subcategories.fields.description")).
				Value(description).
				Required(),
			)
			<div class="flex justify-end space-x-2">
				@components.ButtonLink(routes.CategoryDetails.ReturnOrURL(routes.ID(category.ID), c), components.ButtonConfig(l.Tc("actions.back")).
					Icon(icons.ArrowLeft()).
					Color("neutral"),
				)
				@components.Button(components.ButtonConfig(submitButtonText).
					Type("submit").
					Icon(icons.FloppyDisk()).
					Color("primary"),
				)
			</div>
		</form>
	}
}

templ SubcategoryDetails(c *gin.Context, subcategory repository.SubcategoryWithDetail, products []repository.ProductWithDetail) {
	{{
		l := locales.New(c)

		safeToDelete := false

		if len(products) == 0 {
			safeToDelete = true
		}
	}}
	@layouts.Base(c, l.Tc("subcategories.titles.show"), "categories") {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<div>
					<h1 class="mb-1 text-2xl font-bold">{ subcategory.Name }</h1>
					<p class="text-base-content/70 text-sm">{ l.Tc("categories.label") }: { subcategory.Category.Name }</p>
					<p class="text-base-content/70 text-sm">{ subcategory.Description.String }</p>
				</div>
				<div class="flex gap-2">
					@components.ButtonLink(routes.CategoryDetails.ReturnOrURL(routes.ID(subcategory.CategoryID), c), components.ButtonConfig(l.Tc("actions.back")).
						Icon(icons.ArrowLeft()).
						Color("neutral"),
					)
					@components.ButtonLink(routes.SubcategoryEditForm.URLWithReturnToCurrent(routes.Subcategory(subcategory.CategoryID, subcategory.ID), c), components.ButtonConfig(l.Tc("actions.edit")).
						Icon(icons.PencilSquare()).
						Color("info"),
					)
					@components.Button(components.ButtonConfig(l.Tc("actions.delete")).
						Icon(icons.Trash()).
						Color("error").
						Disabled(!safeToDelete).
						HxDelete(routes.SubcategoryDelete.URLWithReturn(routes.Subcategory(subcategory.CategoryID, subcategory.ID), c)).
						HxConfirm(l.Tc("subcategories.confirm.delete")).
						HxSwap("none"),
					)
				</div>
			</div>
			@ProductsForSubcategoryTable(c, subcategory.CategoryID, subcategory.ID, products, nil)
		</div>
	}
}
