package pages

import (
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/locales"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/templates/layouts"
	"github.com/cyrilschreiber3/stock/utils"
	"github.com/gin-gonic/gin"
	"github.com/invopop/ctxi18n/i18n"
	"time"
)

templ transactionTypeBadge(transactionType string) {
	{{ l := locales.New(ctx) }}
	switch transactionType {
		case "buy":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.types.buy")).Color("primary"))
		case "sell":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.types.sell")).Color("secondary"))
		case "adjustment":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.types.adjustment")).Color("accent"))
		case "correction":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.types.correction")).Color("warning"))
		default:
			@components.Badge(components.BadgeConfig(transactionType).Color("neutral"))
	}
}

templ transactionStateBadge(status string) {
	{{ l := locales.New(ctx) }}
	switch status {
		case "draft":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.states.draft")).Color("neutral"))
		case "pendingRefund":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.states.pending_refund")).Color("warning"))
		case "completed":
			@components.Badge(components.BadgeConfig(l.Tc("transactions.states.completed")).Color("success"))
		default:
			@components.Badge(components.BadgeConfig(status).Color("neutral"))
	}
}

templ Transactions(c *gin.Context, transactions []repository.TransactionWithDetail) {
	{{ l := locales.New(c) }}
	@layouts.Base(c, l.Tc("transactions.label_plural"), "transactions") {
		<div class="flex flex-col gap-6">
			<div class="flex justify-between">
				<h1 class="text-2xl font-bold">{ l.Tc("transactions.label_plural") }</h1>
				@components.ButtonLink(routes.TransactionCreateForm.URL(), components.ButtonConfig(l.Tc("actions.create")).
					Icon(icons.Plus()).
					Color("primary"),
				)
			</div>
			@TransactionsTable(c, transactions, nil)
		</div>
	}
}

templ TransactionRow(c *gin.Context, transaction repository.TransactionWithDetail) {
	@TransactionsTableRow(c, transaction)
}

templ TransactionDetails(c *gin.Context, transaction repository.TransactionWithDetail, transactionItems []repository.TransactionItemWithDetail) {
	{{
		l := locales.New(c)

		supplierName := "N/A"
		if transaction.SupplierID != nil {
			supplierName = transaction.Supplier.Name
		}

		editable := transaction.State == "draft"
	}}
	@layouts.Base(c, l.Tc("transactions.titles.show"), "transactions") {
		<div class="flex flex-col gap-6">
			<div class="flex justify-between">
				<h1 class="text-2xl font-bold">{{ l.Tc("transactions.titles.show") }}</h1>
			</div>
			<div class="card card-border bg-base-100 w-96">
				<div class="card-body">
					<p>
						<strong>{ l.Tc("transactions.fields.date_label") }:</strong>&nbsp;
						<span class="tooltip" data-tip={ utils.PgDateToString(transaction.TransactionDate) }>{ utils.PgDateToNaturalLanguage(transaction.TransactionDate) }</span>
					</p>
					<p>
						<strong>{ l.Tc("transactions.fields.type") }:</strong>&nbsp;
						@transactionTypeBadge(transaction.TransactionType)
					</p>
					<p>
						<strong>{ l.Tc("transactions.fields.state") }:</strong>&nbsp;
						@transactionStateBadge(transaction.State)
					</p>
					<p><strong>{ l.Tc("transactions.fields.supplier") }:</strong> { supplierName }</p>
					<p><strong>{ l.Tc("transactions.fields.base_price") }:</strong> <span id="transaction-base-price">{ utils.PgNumericToString(transaction.BasePrice, "0.00") } CHF</span></p>
					<p><strong>{ l.Tc("transactions.fields.final_price") }:</strong> <span id="transaction-final-price">{ utils.PgNumericToString(transaction.FinalPrice, "0.00") } CHF</span></p>
					if transaction.AppliedAt.Valid {
						<p><strong>{ l.Tc("transactions.fields.applied_at") }:</strong> <span class="tooltip" data-tip={ utils.PgTimestampToString(transaction.AppliedAt) }>{ utils.PgTimestampToNaturalLanguage(transaction.AppliedAt) }</span></p>
					}
					if transaction.Description != "" {
						<p><strong>{ l.Tc("transactions.fields.description") }:</strong> { transaction.Description }</p>
					}
				</div>
			</div>
			<div class="flex justify-between">
				<h2 class="text-xl font-bold">{ l.Tc("transaction_items.label_plural") }</h2>
				if editable {
					@components.Button(components.ButtonConfig(l.Tc("transactions.actions.add_product")).
						Icon(icons.Plus()).
						Color("secondary").
						OnClick("document.querySelector('#add_transaction_item_modal #modal-box').dispatchEvent(new Event('resetAddTransactionItemModal')); add_transaction_item_modal.showModal()"),
					)
				}
			</div>
			@TransactionItemsTable(c, transaction.ID, transactionItems, editable, nil)
			<div class="flex justify-end gap-2">
				@components.ButtonLink(routes.TransactionList.URL(), components.ButtonConfig(l.Tc("transactions.actions.back")).
					Icon(icons.ArrowLeft()).
					Color("neutral"),
				)
				switch transaction.State {
					case "draft":
						@components.ButtonLink(routes.TransactionEditForm.URLWithReturnToCurrent(routes.ID(transaction.ID), c),
							components.ButtonConfig(l.Tc("actions.edit")).
								Icon(icons.PencilSquare()).
								Color("primary"),
						)
						@components.ButtonDropdown(components.ButtonConfig(l.Tc("transactions.actions.apply")).
							Icon(icons.Check()).
							Color("success").
							Classes("join-item").
							HxPost(routes.TransactionApply.URL(routes.ID(transaction.ID))).
							HxConfirm(l.Tc("transactions.confirm.apply")).
							HxSwap("none").
							Hx("vals", `{"state":"completed"}`),
							components.Button(components.ButtonConfig(l.Tc("transactions.actions.apply_without_refund")).
								Icon(icons.HourGlass()).
								Color("warning").
								HxPost(routes.TransactionApply.URL(routes.ID(transaction.ID))).
								HxConfirm(l.Tc("transactions.confirm.apply_without_refund")).
								HxSwap("none").
								Hx("vals", `{"state":"pendingRefund"}`),
							),
						)
						@components.Button(components.ButtonConfig(l.Tc("actions.delete")).
							Icon(icons.Trash()).
							Color("error").
							HxDelete(routes.TransactionDelete.URL(routes.ID(transaction.ID))).
							HxConfirm(l.Tc("transactions.confirm.delete")),
						)
					case "pendingRefund":
						@components.Button(components.ButtonConfig(l.Tc("transactions.actions.set_completed")).
							Icon(icons.ArrowPath()).
							Color("warning").
							HxPost(routes.TransactionApply.URL(routes.ID(transaction.ID))).
							HxConfirm(l.Tc("transactions.confirm.complete")).
							HxSwap("none").
							Hx("vals", `{"state":"completed"}`),
						)
				}
			</div>
			<dialog id="edit_transaction_item_modal" class="modal">
				<div id="modal-box" class="modal-box" hx-on:htmx:after-swap="if(event.detail.successful) { edit_transaction_item_modal.showModal(); }"></div>
				<form method="dialog" class="modal-backdrop">
					<button>{ l.Tc("actions.close") }</button>
				</form>
			</dialog>
			<dialog id="add_transaction_item_modal" class="modal">
				<div id="modal-box" class="modal-box" hx-get={ routes.TransactionSearchProductsForm.URL(routes.ID(transaction.ID)) } hx-trigger="load, resetAddTransactionItemModal"></div>
				<form method="dialog" class="modal-backdrop">
					<button>{ l.Tc("actions.close") }</button>
				</form>
			</dialog>
		</div>
	}
}

templ CreateUpdateTransaction(c *gin.Context, transaction *repository.Transaction) {
	{{
		l := locales.New(c)

		windowTitle := l.Tc("transactions.titles.new")
		title := l.Tc("transactions.titles.new")
		formMethod := "post"
		formAction := routes.TransactionCreate.URLWithReturn(c)
		submitButtonText := l.Tc("actions.create")

		transactionDate := time.Now().Format("2006-01-02")
		transactionType := ""
		supplierID := ""
		description := ""

		if transaction != nil {
			windowTitle = l.Tc("transactions.titles.edit")
			title = l.Tc("transactions.titles.edit_dated", i18n.M{"date": utils.PgDateToString(transaction.TransactionDate)})
			formMethod = "put"
			formAction = routes.TransactionUpdate.URLWithReturn(routes.ID(transaction.ID), c)
			submitButtonText = l.Tc("actions.update")

			transactionDate = utils.PgDateToFormString(transaction.TransactionDate)
			transactionType = transaction.TransactionType
			if transaction.SupplierID != nil {
				supplierID = transaction.SupplierID.String()
			}
			description = transaction.Description
		}
	}}
	@layouts.Base(c, windowTitle, "transactions") {
		<h1 class="mb-4 text-2xl font-bold">{ title }</h1>
		<form id="supplier-form" name="supplier-form" { "hx-" + formMethod }={ formAction } hx-swap="none">
			@components.FormField(components.FormFieldConfig("transaction_date").
				Type("date").
				Label(l.Tc("transactions.fields.date_label")).
				Placeholder("DD-MM-YYYY").
				ValidationPreset("dateInPast").
				Value(transactionDate).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("transaction_type").
				Type("select").
				Label(l.Tc("transactions.fields.type_label")).
				Placeholder(l.Tc("transactions.placeholders.type")).
				Value(transactionType).
				Options(map[string]string{
					"buy":        l.Tc("transactions.types.buy"),
					"sell":       l.Tc("transactions.types.sell"),
					"adjustment": l.Tc("transactions.types.adjustment"),
				}).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("supplier_id").
				Type("select").
				Label(l.Tc("transactions.fields.supplier")).
				Placeholder(l.Tc("transactions.placeholders.supplier")).
				Value(supplierID).
				OptionsFromEndpoint(routes.SupplierOptions.URL()),
			)
			@components.FormField(components.FormFieldConfig("description").
				Type("textarea").
				Label(l.Tc("transactions.fields.description")).
				Placeholder(l.Tc("transactions.placeholders.description")).
				Value(description),
			)
			<div class="flex justify-end space-x-2">
				@components.ButtonLink(routes.TransactionList.ReturnOrURL(c), components.ButtonConfig(l.Tc("actions.back")).
					Icon(icons.ArrowLeft()).
					Color("neutral"),
				)
				@components.Button(components.ButtonConfig(submitButtonText).
					Type("submit").
					Icon(icons.FloppyDisk()).
					Color("primary"),
				)
			</div>
		</form>
	}
}
