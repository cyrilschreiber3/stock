package pages

import (
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/utils"
	"github.com/gin-gonic/gin"
	"github.com/google/uuid"
)

var CategoriesTableColumns = []components.DataTableColumn{
	components.NewDataTableColumn("Name", "name"),
	components.NewUnsortedDataTableColumn("Description", "description"),
	components.NewDataTableColumn("Last updated", "updated_at"),
	components.NewActionDataTableColumn(),
}

func GetDefaultCategoriesTableConfig() *components.DataTableConfig {
	return components.NewDataTableConfig("categories").
		SetLabel("Categories list").
		SetSearchPlaceholder("Search categories").
		SetItemLabel("categories", "category").
		SetURL(routes.CategorySearch).
		SetSortKey("name").
		SetSortDirection("asc").
		AddColumns(CategoriesTableColumns...)
}

templ CategoriesTableRow(c *gin.Context, category repository.Category) {
	<tr class="hover:bg-base-300">
		<td>
			<a class="link link-hover" href={ routes.CategoryDetails.URL(routes.ID(category.ID)) }>
				{ category.Name }
			</a>
		</td>
		<td>{ category.Description.String }</td>
		<td>
			<div class="tooltip" data-tip={ utils.PgTimestampToString(category.UpdatedAt) }>
				{ utils.PgTimestampToNaturalLanguage(category.UpdatedAt) }
			</div>
		</td>
		<td>
			<div class="flex space-x-2">
				@components.ButtonLink(routes.CategoryDetails.URL(routes.ID(category.ID)), components.ButtonConfig("").
					Icon(icons.InformationCircle()).
					Color("primary").
					Style("soft").
					Size("sm"),
				)
				@components.ButtonLink(routes.CategoryEditForm.URLWithReturnToCurrent(routes.ID(category.ID), c), components.ButtonConfig("").
					Icon(icons.PencilSquare()).
					Color("info").
					Style("soft").
					Size("sm"),
				)
				@components.Button(components.ButtonConfig("").
					Type("button").
					Icon(icons.Trash()).
					Color("error").
					Style("soft").
					Size("sm").
					HxDelete(routes.CategoryDelete.URL(routes.ID(category.ID))).
					HxConfirm("Are you sure you want to delete this category?").
					HxTarget("closest tr").
					HxSwap("delete"),
				)
			</div>
		</td>
	</tr>
}

templ CategoriesTable(c *gin.Context, categories []repository.Category, tableConfig *components.DataTableConfig) {
	{{
		if tableConfig == nil {
			tableConfig = GetDefaultCategoriesTableConfig().GetConfigFromURL(c)
		}
		tableConfig = tableConfig.
			SetItemCount(len(categories)).
			SetConfigToURL(c)
	}}
	@components.DataTable(c, tableConfig) {
		for i := tableConfig.GetPageOffset(); i < tableConfig.GetPageOffset()+tableConfig.GetPageLimit(len(categories)); i++ {
			@CategoriesTableRow(c, categories[i])
		}
	}
}

var SubcategoriesForCategoryTableColumns = []components.DataTableColumn{
	components.NewDataTableColumn("Name", "name"),
	components.NewUnsortedDataTableColumn("Description", "description"),
	components.NewDataTableColumn("Last updated", "updated_at"),
	components.NewActionDataTableColumn(),
}

func GetDefaultSubcategoriesForCategoryTableConfig(categoryID uuid.UUID) *components.DataTableConfig {
	return components.NewDataTableConfig("subcategories").
		SetLabel("Subcategories for category").
		SetSearchPlaceholder("Search subcategories").
		SetItemLabel("subcategories", "subcategory").
		SetURLString(routes.SubcategorySearch.URL(routes.ID(categoryID))).
		SetSortKey("name").
		SetSortDirection("asc").
		AddColumns(SubcategoriesForCategoryTableColumns...)
}

templ SubcategoriesForCategoryTableRow(c *gin.Context, subcategory repository.SubcategoryWithDetail) {
	<tr class="hover:bg-base-300">
		<td>
			<a class="link link-hover" href={ routes.SubcategoryDetails.URLWithReturnToCurrent(routes.Subcategory(subcategory.CategoryID, subcategory.ID), c) }>
				{ subcategory.Name }
			</a>
		</td>
		<td>{ subcategory.Description.String }</td>
		<td>
			<div class="tooltip" data-tip={ utils.PgTimestampToString(subcategory.UpdatedAt) }>
				{ utils.PgTimestampToNaturalLanguage(subcategory.UpdatedAt) }
			</div>
		</td>
		<td>
			<div class="flex space-x-2">
				@components.ButtonLink(routes.SubcategoryDetails.URLWithReturnToCurrent(routes.Subcategory(subcategory.CategoryID, subcategory.ID), c), components.ButtonConfig("").
					Icon(icons.InformationCircle()).
					Color("primary").
					Style("soft").
					Size("sm"),
				)
				@components.ButtonLink(routes.SubcategoryEditForm.URLWithReturnToCurrent(routes.Subcategory(subcategory.CategoryID, subcategory.ID), c), components.ButtonConfig("").
					Icon(icons.PencilSquare()).
					Color("info").
					Style("soft").
					Size("sm"),
				)
				@components.Button(components.ButtonConfig("").
					Type("button").
					Icon(icons.Trash()).
					Color("error").
					Style("soft").
					Size("sm").
					HxDelete(routes.SubcategoryDelete.URL(routes.Subcategory(subcategory.CategoryID, subcategory.ID))).
					HxConfirm("Are you sure you want to delete this sub-category?").
					HxTarget("closest tr").
					HxSwap("delete"),
				)
			</div>
		</td>
	</tr>
}

templ SubcategoriesForCategoryTable(c *gin.Context, categoryID uuid.UUID, subcategories []repository.SubcategoryWithDetail, tableConfig *components.DataTableConfig) {
	{{
		if tableConfig == nil {
			tableConfig = GetDefaultSubcategoriesForCategoryTableConfig(categoryID).GetConfigFromURL(c)
		}
		tableConfig = tableConfig.
			SetItemCount(len(subcategories)).
			SetConfigToURL(c)
	}}
	@components.DataTable(c, tableConfig) {
		for i := tableConfig.GetPageOffset(); i < tableConfig.GetPageOffset()+tableConfig.GetPageLimit(len(subcategories)); i++ {
			@SubcategoriesForCategoryTableRow(c, subcategories[i])
		}
	}
}

var ProductsForCategoryTableColumns = []components.DataTableColumn{
	components.NewDataTableColumn("Brand", "brand"),
	components.NewDataTableColumn("Name", "name"),
	components.NewDataTableColumn("Sub-category", "subcategory_name"),
	components.NewDataTableColumn("Default supplier", "supplier_name"),
	components.NewUnsortedDataTableColumn("Aliases", "aliases"),
	components.NewDataTableColumn("Last updated", "updated_at"),
	components.NewActionDataTableColumn(),
}

func GetDefaultProductsForCategoryTableConfig(categoryID uuid.UUID) *components.DataTableConfig {
	return components.NewDataTableConfig("products").
		SetLabel("Products for category").
		SetSearchPlaceholder("Search products").
		SetItemLabel("products", "product").
		SetURLString(routes.CategorySearchProducts.URL(routes.ID(categoryID))).
		SetSortKey("name").
		SetSortDirection("asc").
		AddColumns(ProductsForCategoryTableColumns...)
}

templ ProductsForCategoryTableRow(c *gin.Context, product repository.ProductWithDetail) {
	<tr class="hover:bg-base-300">
		<td>
			<a class="link link-hover" href={ routes.BrandDetails.URLWithReturnToCurrent(routes.Name(product.Brand), c) }>
				{ product.Brand }
			</a>
		</td>
		<td>
			<a class="link link-hover" href={ routes.ProductDetails.URLWithReturnToCurrent(routes.ID(product.ID), c) }>
				{ product.Name }
			</a>
		</td>
		<td>
			<a class="link link-hover" href={ routes.SubcategoryDetails.URLWithReturnToCurrent(routes.Subcategory(product.CategoryID, product.SubcategoryID), c) }>
				{ product.Subcategory.Name }
			</a>
		</td>
		<td>
			<a class="link link-hover" href={ routes.SupplierDetails.URLWithReturnToCurrent(routes.ID(product.DefaultSupplierID), c) }>
				{ product.Supplier.Name }
			</a>
		</td>
		<td>
			<div class="flex flex-wrap gap-2">
				for _, alias := range product.Aliases {
					@components.Badge(components.BadgeConfig(alias).Color("primary"))
				}
			</div>
		</td>
		<td>
			<div class="tooltip" data-tip={ utils.PgTimestampToString(product.UpdatedAt) }>
				{ utils.PgTimestampToNaturalLanguage(product.UpdatedAt) }
			</div>
		</td>
		<td>
			<div class="flex gap-2">
				@components.ButtonLink(routes.ProductDetails.URLWithReturnToCurrent(routes.ID(product.ID), c), components.ButtonConfig("").
					Icon(icons.InformationCircle()).
					Color("primary").
					Style("soft").
					Size("sm"),
				)
				@components.ButtonLink(routes.ProductEditForm.URLWithReturnToCurrent(routes.ID(product.ID), c), components.ButtonConfig("").
					Icon(icons.PencilSquare()).
					Color("info").
					Style("soft").
					Size("sm"),
				)
				@components.Button(components.ButtonConfig("").
					Type("button").
					Icon(icons.Trash()).
					Color("error").
					Style("soft").
					Size("sm").
					HxDelete(routes.ProductDelete.URL(routes.ID(product.ID))).
					HxConfirm("Are you sure you want to delete this product?").
					HxTarget("closest tr").
					HxSwap("delete"),
				)
			</div>
		</td>
	</tr>
}

templ ProductsForCategoryTable(c *gin.Context, categoryID uuid.UUID, products []repository.ProductWithDetail, tableConfig *components.DataTableConfig) {
	{{
		if tableConfig == nil {
			tableConfig = GetDefaultProductsForCategoryTableConfig(categoryID).GetConfigFromURL(c)
		}
		tableConfig = tableConfig.
			SetItemCount(len(products)).
			SetConfigToURL(c)
	}}
	@components.DataTable(c, tableConfig) {
		for i := tableConfig.GetPageOffset(); i < tableConfig.GetPageOffset()+tableConfig.GetPageLimit(len(products)); i++ {
			@ProductsForCategoryTableRow(c, products[i])
		}
	}
}
