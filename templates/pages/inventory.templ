package pages

import (
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/locales"
	"github.com/cyrilschreiber3/stock/templates/layouts"
	"github.com/gin-gonic/gin"
)

templ Inventory(c *gin.Context, inventory []repository.InventoryWithDetail) {
	{{ l := locales.New(c) }}
	@layouts.Base(c, l.Tc("inventory.titles.index"), "inventory") {
		<div class="flex flex-col gap-6">
			<div class="flex justify-between">
				<h1 class="text-2xl font-bold">{ l.Tc("inventory.titles.index") }</h1>
			</div>
			@InventoryTable(c, inventory, nil)
		</div>
	}
}
