package pages

import (
	"fmt"
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/templates/layouts"
	"github.com/cyrilschreiber3/stock/utils"
	"github.com/gin-gonic/gin"
)

templ Products(c *gin.Context, products []repository.ProductWithDetail) {
	@layouts.Base(c, "Stock") {
		<div class="my-5 flex justify-between">
			<h1 class="text-2xl font-bold">Products</h1>
			@components.ButtonLink(routes.ProductCreateForm.URL(), components.ButtonConfig("Create").
				Icon(icons.Plus()).
				Color("primary"),
			)
		</div>
		<div class="rounded-box border-base-content/5 bg-base-100 overflow-x-auto border">
			<table class="table">
				<thead>
					<tr>
						<th>Brand</th>
						<th>Name</th>
						<th>Category</th>
						<th>Sub-category</th>
						<th>Default supplier</th>
						<th>Base buy price</th>
						<th>Base sell price</th>
						<th>Aliases</th>
						<th>Created</th>
						<th>Last updated</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, product := range products {
						<tr>
							<td>{ product.Brand }</td>
							<td>{ product.Name }</td>
							<td>{ product.Category.Name }</td>
							<td>{ product.Subcategory.Name }</td>
							<td>{ product.Supplier.Name }</td>
							<td>{ utils.PgNumericToString(product.DefaultBuyPrice, "0.00") } CHF</td>
							<td>{ utils.PgNumericToString(product.DefaultSellPrice, "0.00") } CHF</td>
							<td class="space-x-2 space-y-2">
								for _, alias := range product.Aliases {
									@components.Badge(components.BadgeConfig(alias).Color("primary"))
								}
							</td>
							<td>
								<div class="tooltip" data-tip={ utils.PgTimestampToString(product.CreatedAt) }>
									{ utils.PgTimestampToNaturalLanguage(product.CreatedAt) }
								</div>
							</td>
							<td>
								<div class="tooltip" data-tip={ utils.PgTimestampToString(product.UpdatedAt) }>
									{ utils.PgTimestampToNaturalLanguage(product.UpdatedAt) }
								</div>
							</td>
							<td>
								<div class="flex space-x-2">
									@components.ButtonLink(routes.ProductDetails.URL(routes.ID(product.ID)), components.ButtonConfig("Details").
										Icon(icons.InformationCircle()).
										Style("soft").
										Size("sm").
										Color("primary"),
									)
									@components.ButtonLink(routes.ProductEditForm.URLWithReturnToCurrent(routes.ID(product.ID), c), components.ButtonConfig("Edit").
										Icon(icons.PencilSquare()).
										Style("soft").
										Size("sm").
										Color("info"),
									)
									@components.Button(components.ButtonConfig("Delete").
										Icon(icons.Trash()).
										Color("error").
										Style("soft").
										Size("sm").
										HxDelete(routes.ProductDelete.URL(routes.ID(product.ID))).
										HxConfirm("Are you sure you want to delete this product?").
										HxTarget("closest tr").
										HxSwap("delete"),
									)
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ CreateUpdateProduct(c *gin.Context, product *repository.Product) {
	@layouts.Base(c, "Stock") {
		{{
			title := "Create product"
			formMethod := "post"
			formAction := routes.ProductCreate.URL()
			submitButtonText := "Create"

			brand := ""
			name := ""
			categoryID := ""
			subcategoryID := ""
			supplierID := ""
			defaultBuy := ""
			defaultSell := ""
			aliases := []string{}

			if product != nil {
				title = "Update product: " + product.Name
				formMethod = "put"
				formAction = routes.ProductUpdate.URLWithReturn(routes.ID(product.ID), c)
				submitButtonText = "Update"

				brand = product.Brand
				name = product.Name
				categoryID = product.CategoryID.String()
				subcategoryID = product.SubcategoryID.String()
				supplierID = product.DefaultSupplierID.String()
				defaultBuy = utils.PgNumericToString(product.DefaultBuyPrice, "0.00")
				defaultSell = utils.PgNumericToString(product.DefaultSellPrice, "0.00")
				aliases = product.Aliases
			}
		}}
		<h1 class="mb-4 text-2xl font-bold">{ title }</h1>
		<form id="product-form" name="product-form" { "hx-" + formMethod }={ formAction } hx-swap="none">
			@components.FormField(components.FormFieldConfig("brand").
				Type("text").
				Label("Product Brand").
				Placeholder("Dr. Gabs").
				Value(brand).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("name").
				Type("text").
				Label("Product Name").
				Placeholder("SWAF").
				Value(name).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("category_id").
				Type("select").
				Label("Category").
				Placeholder("Select a category").
				Value(categoryID).
				Required().
				OptionsFromEndpoint(routes.CategoryOptions.URL()),
			)
			@components.FormField(components.FormFieldConfig("subcategory_id").
				Type("select").
				Label("Sub-category").
				Placeholder("Select a sub-category").
				Value(subcategoryID).
				Required().
				OptionsFromEndpoint(routes.SubcategoryOptions.Pattern()).
				DependsOn("category_id"),
			)
			@components.FormField(components.FormFieldConfig("default_supplier_id").
				Type("select").
				Label("Default Supplier").
				Placeholder("Select a supplier").
				Value(supplierID).
				Required().
				OptionsFromEndpoint(routes.SupplierOptions.URL()),
			)
			@components.FormField(components.FormFieldConfig("default_buy_price").
				Type("number").
				Label("Base Buy Price").
				Placeholder("3.00").
				Value(defaultBuy).
				ValidationPreset("money").
				Suffix("CHF").
				Required(),
			)
			@components.FormField(components.FormFieldConfig("default_sell_price").
				Type("number").
				Label("Base Sell Price").
				Placeholder("4.50").
				Value(defaultSell).
				ValidationPreset("money").
				Suffix("CHF").
				Required(),
			)
			@components.FormField(components.FormFieldConfig("aliases").
				Type("text").
				Label("Aliases").
				Placeholder("Alternate product name").
				AsList().
				ValueList(aliases).
				Required(),
			)
			<div class="mt-6 flex justify-end gap-2">
				@components.ButtonLink(routes.ProductList.ReturnOrURL(c), components.ButtonConfig("Back").
					Icon(icons.ArrowLeft()).
					Color("neutral"),
				)
				@components.Button(components.ButtonConfig(submitButtonText).
					Type("submit").
					Icon(icons.DocumentCheck()).
					Color("primary"),
				)
			</div>
		</form>
	}
}

templ ProductDetails(c *gin.Context, product repository.ProductWithDetail, inventoryLots []repository.InventoryLot, transactions []repository.TransactionWithDetailsAndItem) {
	@layouts.Base(c, "Stock") {
		<div class="my-5 flex justify-between">
			<h1 class="text-2xl font-bold">{ product.Brand + " - " + product.Name }</h1>
			<div class="flex space-x-2">
				@components.ButtonLink(routes.ProductEditForm.URLWithReturnToCurrent(routes.ID(product.ID), c), components.ButtonConfig("Edit").
					Icon(icons.PencilSquare()).
					Color("info"),
				)
				@components.Button(components.ButtonConfig("Delete").
					Icon(icons.Trash()).
					Color("error").
					HxDelete(routes.ProductDelete.URLWithReturnToCurrent(routes.ID(product.ID), c)).
					HxConfirm("Are you sure you want to delete this product?").
					HxSwap("none"),
				)
			</div>
		</div>
		<div id="product-details" class="rounded-box border-base-content/5 bg-base-100 overflow-x-auto border">
			<table class="table w-full">
				<tbody>
					<tr>
						<th>Brand</th>
						<td>{ product.Brand }</td>
					</tr>
					<tr>
						<th>Name</th>
						<td>{ product.Name }</td>
					</tr>
					<tr>
						<th>Category</th>
						<td>{ product.Category.Name }</td>
					</tr>
					<tr>
						<th>Sub-category</th>
						<td>{ product.Subcategory.Name }</td>
					</tr>
					<tr>
						<th>Default supplier</th>
						<td>{ product.Supplier.Name }</td>
					</tr>
					<tr>
						<th>Base buy price</th>
						<td>{ utils.PgNumericToString(product.DefaultBuyPrice, "0.00") } CHF</td>
					</tr>
					<tr>
						<th>Base sell price</th>
						<td>{ utils.PgNumericToString(product.DefaultSellPrice, "0.00") } CHF</td>
					</tr>
					<tr>
						<th>Aliases</th>
						for _, alias := range product.Aliases {
							if alias != "" {
								<td>
									@components.Badge(components.BadgeConfig(alias).Color("primary"))
								</td>
							}
						}
					</tr>
					<tr>
						<th>Created</th>
						<td>
							<div class="tooltip" data-tip={ utils.PgTimestampToString(product.CreatedAt) }>
								{ utils.PgTimestampToNaturalLanguage(product.CreatedAt) }
							</div>
						</td>
					</tr>
					<tr>
						<th>Last updated</th>
						<td>
							<div class="tooltip" data-tip={ utils.PgTimestampToString(product.UpdatedAt) }>
								{ utils.PgTimestampToNaturalLanguage(product.UpdatedAt) }
							</div>
						</td>
					</tr>
					<tr>
						<th>Inventory quantity</th>
						<td>{ fmt.Sprintf("%d", product.InventoryQuantity) }</td>
					</tr>
				</tbody>
			</table>
		</div>
		<h2 class="mt-6 text-2xl font-bold">Transactions</h2>
		<div id="product-transactions" class="rounded-box border-base-content/5 bg-base-100 mt-6 overflow-x-auto border">
			<table class="table w-full">
				<thead>
					<tr>
						<th>Transaction ID</th>
						<th>Type</th>
						<th>Total price</th>
						<th>Supplier</th>
						<th>Date</th>
					</tr>
				</thead>
				<tbody>
					for _, transaction := range transactions {
						{{
							supplierName := "N/A"
							if transaction.Supplier.Name != "" {
								supplierName = transaction.Supplier.Name
							}
						}}
						<tr>
							<td>{ transaction.ID.String() }</td>
							<td>{ transaction.TransactionType }</td>
							<td>{ utils.PgNumericToString(transaction.FinalPrice, "0.00") } CHF</td>
							<td>{ supplierName }</td>
							<td>
								<div class="tooltip" data-tip={ utils.PgTimestampToString(transaction.CreatedAt) }>
									{ utils.PgTimestampToNaturalLanguage(transaction.CreatedAt) }
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h2 class="mt-6 text-2xl font-bold">Inventory Lots</h2>
		<div id="product-inventory-lots" class="rounded-box border-base-content/5 bg-base-100 mt-6 overflow-x-auto border">
			<table class="table w-full">
				<thead>
					<tr>
						<th>Lot ID</th>
						<th>Received quantity</th>
						<th>Remaining quantity</th>
						<th>Unit Cost</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					for _, lot := range inventoryLots {
						<tr>
							<td>{ lot.ID.String() }</td>
							<td>{ fmt.Sprintf("%d", lot.ReceivedQuantity) }</td>
							<td>{ fmt.Sprintf("%d", lot.RemainingQuantity) }</td>
							<td>{ utils.PgNumericToString(lot.UnitCost, "0.00") } CHF</td>
							<td>
								<div class="tooltip" data-tip={ utils.PgTimestampToString(lot.CreatedAt) }>
									{ utils.PgTimestampToNaturalLanguage(lot.CreatedAt) }
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
