package pages

import (
	"fmt"
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/locales"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/templates/layouts"
	"github.com/cyrilschreiber3/stock/utils"
	"github.com/gin-gonic/gin"
	"github.com/invopop/ctxi18n/i18n"
)

templ Products(c *gin.Context, products []repository.ProductWithDetail) {
	{{ l := locales.New(c) }}
	@layouts.Base(c, l.Tc("products.label_plural"), "products") {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<div>
					<h1 class="text-base-content text-3xl font-bold">{ l.Tc("products.label_plural") }</h1>
				</div>
				<div class="flex gap-2">
					@components.ButtonLink(routes.ProductCreateForm.URL(), components.ButtonConfig(l.Tc("actions.create")).
						Icon(icons.Plus()).
						Color("primary"),
					)
				</div>
			</div>
			@ProductsTable(c, products, nil)
		</div>
	}
}

templ CreateUpdateProduct(c *gin.Context, product *repository.Product) {
	{{
		l := locales.New(c)

		windowTitle := l.Tc("products.titles.new")
		title := l.Tc("products.titles.new")
		formMethod := "post"
		formAction := routes.ProductCreate.URL()
		submitButtonText := l.Tc("actions.create")

		brand := ""
		name := ""
		categoryID := ""
		subcategoryID := ""
		supplierID := ""
		defaultBuy := ""
		defaultSell := ""
		aliases := []string{}

		if product != nil {
			windowTitle = l.Tc("products.titles.edit")
			title = l.Tc("products.titles.edit_named", i18n.M{"name": product.Name})
			formMethod = "put"
			formAction = routes.ProductUpdate.URLWithReturn(routes.ID(product.ID), c)
			submitButtonText = l.Tc("actions.update")

			brand = product.Brand
			name = product.Name
			categoryID = product.CategoryID.String()
			subcategoryID = product.SubcategoryID.String()
			supplierID = product.DefaultSupplierID.String()
			defaultBuy = utils.PgNumericToString(product.DefaultBuyPrice, "0.00")
			defaultSell = utils.PgNumericToString(product.DefaultSellPrice, "0.00")
			aliases = product.Aliases
		}
	}}
	@layouts.Base(c, windowTitle, "products") {
		<h1 class="mb-4 text-2xl font-bold">{ title }</h1>
		<form id="product-form" name="product-form" { "hx-" + formMethod }={ formAction } hx-swap="none">
			@components.FormField(components.FormFieldConfig("brand").
				Type("text").
				Label(l.Tc("products.fields.brand_label")).
				Placeholder("Dr. Gabs").
				Value(brand).
				DatalistOptionsFromEndpoint(routes.BrandOptions.URL()).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("name").
				Type("text").
				Label(l.Tc("products.fields.name_label")).
				Placeholder("SWAF").
				Value(name).
				Required(),
			)
			@components.FormField(components.FormFieldConfig("category_id").
				Type("select").
				Label(l.Tc("categories.label")).
				Placeholder(l.Tc("products.placeholders.category")).
				Value(categoryID).
				Required().
				OptionsFromEndpoint(routes.CategoryOptions.URL()),
			)
			@components.FormField(components.FormFieldConfig("subcategory_id").
				Type("select").
				Label(l.Tc("subcategories.label")).
				Placeholder(l.Tc("products.placeholders.subcategory")).
				Value(subcategoryID).
				Required().
				OptionsFromEndpoint(routes.SubcategoryOptions.Pattern()).
				DependsOn("category_id"),
			)
			@components.FormField(components.FormFieldConfig("default_supplier_id").
				Type("select").
				Label(l.Tc("products.fields.supplier")).
				Placeholder(l.Tc("products.placeholders.supplier")).
				Value(supplierID).
				Required().
				OptionsFromEndpoint(routes.SupplierOptions.URL()),
			)
			@components.FormField(components.FormFieldConfig("default_buy_price").
				Type("number").
				Label(l.Tc("products.fields.buy_price")).
				Placeholder("3.00").
				Value(defaultBuy).
				ValidationPreset("money").
				Suffix("CHF").
				Required(),
			)
			@components.FormField(components.FormFieldConfig("default_sell_price").
				Type("number").
				Label(l.Tc("products.fields.sell_price")).
				Placeholder("4.50").
				Value(defaultSell).
				ValidationPreset("money").
				Suffix("CHF").
				Required(),
			)
			@components.FormField(components.FormFieldConfig("aliases").
				Type("text").
				Label(l.Tc("products.fields.aliases")).
				Placeholder(l.Tc("products.placeholders.alias")).
				AsList().
				ValueList(aliases).
				Required(),
			)
			<div class="mt-6 flex justify-end gap-2">
				@components.ButtonLink(routes.ProductList.ReturnOrURL(c), components.ButtonConfig(l.Tc("actions.back")).
					Icon(icons.ArrowLeft()).
					Color("neutral"),
				)
				@components.Button(components.ButtonConfig(submitButtonText).
					Type("submit").
					Icon(icons.DocumentCheck()).
					Color("primary"),
				)
			</div>
		</form>
	}
}

templ ProductDetails(c *gin.Context, product repository.ProductWithDetail, inventoryLots []repository.InventoryLotWithDetail, transactions []repository.TransactionWithDetailsAndItem) {
	{{ l := locales.New(c) }}
	@layouts.Base(c, l.Tc("products.titles.show"), "products") {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<h1 class="text-2xl font-bold">{ product.Brand + " - " + product.Name }</h1>
				<div class="flex gap-2">
					@components.ButtonLink(routes.ProductList.ReturnOrURL(c), components.ButtonConfig(l.Tc("actions.back")).
						Icon(icons.ArrowLeft()).
						Color("neutral"),
					)
					@components.ButtonLink(routes.ProductEditForm.URLWithReturnToCurrent(routes.ID(product.ID), c), components.ButtonConfig(l.Tc("actions.edit")).
						Icon(icons.PencilSquare()).
						Color("info"),
					)
					@components.Button(components.ButtonConfig(l.Tc("actions.delete")).
						Icon(icons.Trash()).
						Color("error").
						HxDelete(routes.ProductDelete.URLWithReturn(routes.ID(product.ID), c)).
						HxConfirm(l.Tc("products.confirm.delete")).
						HxSwap("none"),
					)
				</div>
			</div>
			<div id="product-details" class="rounded-box border-base-content/5 bg-base-100 overflow-x-auto border">
				<table class="table w-full">
					<tbody>
						<tr>
							<th>{ l.Tc("products.fields.brand") }</th>
							<td>
								<a class="link link-hover" href={ routes.BrandDetails.URLWithReturnToCurrent(routes.Name(product.Brand), c) }>
									{ product.Brand }
								</a>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("table.columns.name") }</th>
							<td>{ product.Name }</td>
						</tr>
						<tr>
							<th>{ l.Tc("categories.label") }</th>
							<td>
								<a class="link link-hover" href={ routes.CategoryDetails.URLWithReturnToCurrent(routes.ID(product.CategoryID), c) }>
									{ product.Category.Name }
								</a>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("subcategories.label") }</th>
							<td>
								<a class="link link-hover" href={ routes.SubcategoryDetails.URLWithReturnToCurrent(routes.Subcategory(product.CategoryID, product.SubcategoryID), c) }>
									{ product.Subcategory.Name }
								</a>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("products.fields.supplier") }</th>
							<td>
								<a class="link link-hover" href={ routes.SupplierDetails.URLWithReturnToCurrent(routes.ID(product.DefaultSupplierID), c) }>
									{ product.Supplier.Name }
								</a>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("products.fields.buy_price") }</th>
							<td>{ utils.PgNumericToString(product.DefaultBuyPrice, "0.00") } CHF</td>
						</tr>
						<tr>
							<th>{ l.Tc("products.fields.sell_price") }</th>
							<td>{ utils.PgNumericToString(product.DefaultSellPrice, "0.00") } CHF</td>
						</tr>
						<tr>
							<th>{ l.Tc("products.fields.aliases") }</th>
							<td>
								<div class="flex flex-wrap gap-2">
									for _, alias := range product.Aliases {
										if alias != "" {
											@components.Badge(components.BadgeConfig(alias).Color("primary"))
										}
									}
								</div>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("table.columns.created_at") }</th>
							<td>
								<div class="tooltip" data-tip={ utils.PgTimestampToString(product.CreatedAt) }>
									{ utils.PgTimestampToNaturalLanguage(product.CreatedAt) }
								</div>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("table.columns.updated_at") }</th>
							<td>
								<div class="tooltip" data-tip={ utils.PgTimestampToString(product.UpdatedAt) }>
									{ utils.PgTimestampToNaturalLanguage(product.UpdatedAt) }
								</div>
							</td>
						</tr>
						<tr>
							<th>{ l.Tc("products.fields.inventory_quantity") }</th>
							<td>{ fmt.Sprintf("%d", product.InventoryQuantity) }</td>
						</tr>
					</tbody>
				</table>
			</div>
			@TransactionsForProductTable(c, product.ID, transactions, nil)
			@InventoryLotsForProductTable(c, product.ID, inventoryLots, nil)
		</div>
	}
}

templ BrandDetails(c *gin.Context, brand string, products []repository.ProductWithDetail) {
	{{ l := locales.New(c) }}
	@layouts.Base(c, l.Tc("brands.titles.show"), "products") {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<h1 class="text-2xl font-bold">{ brand }</h1>
				<div class="flex gap-2">
					@components.ButtonLink(routes.ProductList.ReturnOrURL(c), components.ButtonConfig(l.Tc("actions.back")).
						Icon(icons.ArrowLeft()).
						Color("neutral"),
					)
				</div>
			</div>
			@ProductsForBrandTable(c, brand, products, nil)
		</div>
	}
}
