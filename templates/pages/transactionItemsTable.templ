package pages

import (
	"github.com/cyrilschreiber3/stock/database/repository"
	"github.com/cyrilschreiber3/stock/locales"
	"github.com/cyrilschreiber3/stock/routes"
	"github.com/cyrilschreiber3/stock/templates/components"
	"github.com/cyrilschreiber3/stock/templates/icons"
	"github.com/cyrilschreiber3/stock/utils"
	"github.com/gin-gonic/gin"
	"github.com/google/uuid"
)

func GetTransactionItemsTableColumns(c *gin.Context) []components.DataTableColumn {
	l := locales.New(c)
	return []components.DataTableColumn{
		components.NewDataTableColumn(l.Tc("transaction_items.fields.product_brand"), "product_brand"),
		components.NewDataTableColumn(l.Tc("transaction_items.fields.product_name"), "product_name"),
		components.NewDataTableColumn(l.Tc("transaction_items.fields.quantity"), "quantity"),
		components.NewDataTableColumn(l.Tc("transaction_items.fields.base_unit_price"), "base_unit_price"),
		components.NewDataTableColumn(l.Tc("transaction_items.fields.final_unit_price"), "final_unit_price"),
	}
}

func GetDefaultTransactionItemsTableConfig(c *gin.Context, transactionID uuid.UUID) *components.DataTableConfig {
	l := locales.New(c)
	return components.NewDataTableConfig("transaction_items").
		SetLabel(l.Tc("transaction_items.titles.index")).
		SetSearchPlaceholder(l.Tc("transaction_items.placeholders.search")).
		SetItemLabel(l.T("transaction_items.label_plural"), l.T("transaction_items.label")).
		SetURLString(routes.TransactionItemSearch.URL(routes.ID(transactionID))).
		AddAdditionalTriggers("txItemsTableRefresh").
		SetSortKey("product_name").
		SetSortDirection("asc").
		AddColumns(GetTransactionItemsTableColumns(c)...)
}

templ TransactionItemsTableRow(c *gin.Context, transactionItem repository.TransactionItemWithDetail, editable bool) {
	{{ l := locales.New(c) }}
	<tr class="hover:bg-base-300">
		<td>
			<a class="link link-hover" href={ routes.BrandDetails.URLWithReturnToCurrent(routes.Name(transactionItem.Product.Brand), c) }>
				{ transactionItem.Product.Brand }
			</a>
		</td>
		<td>
			<a class="link link-hover" href={ routes.ProductDetails.URLWithReturnToCurrent(routes.ID(transactionItem.ProductID), c) }>
				{ transactionItem.Product.Name }
			</a>
		</td>
		<td>{ transactionItem.Quantity }</td>
		<td>{ utils.PgNumericToString(transactionItem.BaseUnitPrice, "0.00") } CHF</td>
		<td>{ utils.PgNumericToString(transactionItem.FinalUnitPrice, "0.00") } CHF</td>
		<td>
			if editable {
				<div class="flex space-x-2">
					@components.Button(components.ButtonConfig("").
						Icon(icons.PencilSquare()).
						Style("soft").
						Size("sm").
						Color("info").
						HxGet(routes.TransactionItemEditForm.URL(routes.TxItem(transactionItem.TransactionID, transactionItem.ID))).
						HxTarget("#edit_transaction_item_modal>#modal-box").
						HxSwap("innerHTML"),
					)
					@components.Button(components.ButtonConfig("").
						Icon(icons.Trash()).
						Color("error").
						Style("soft").
						Size("sm").
						HxDelete(routes.TransactionItemDelete.URL(routes.TxItem(transactionItem.TransactionID, transactionItem.ID))).
						HxConfirm(l.Tc("transaction_items.confirm.delete")).
						HxTarget("closest tr").
						HxSwap("delete"),
					)
				</div>
			}
		</td>
	</tr>
}

templ TransactionItemsTable(c *gin.Context, transactionID uuid.UUID, transactionItems []repository.TransactionItemWithDetail, editable bool, tableConfig *components.DataTableConfig) {
	{{
		if tableConfig == nil {
			tableConfig = GetDefaultTransactionItemsTableConfig(c, transactionID).GetConfigFromURL(c)
		}
		if editable {
			tableConfig = tableConfig.AddColumns(components.NewActionDataTableColumn())
		}
		tableConfig = tableConfig.
			SetItemCount(len(transactionItems)).
			SetConfigToURL(c)
	}}
	@components.DataTable(c, tableConfig) {
		for i := tableConfig.GetPageOffset(); i < tableConfig.GetPageOffset()+tableConfig.GetPageLimit(len(transactionItems)); i++ {
			@TransactionItemsTableRow(c, transactionItems[i], editable)
		}
	}
}
