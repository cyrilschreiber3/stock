package partials

templ Header() {
	<header class="navbar bg-base-100/80 border-base-300 sticky top-0 z-40 border-b px-4 shadow-sm backdrop-blur-md sm:px-6 lg:px-8">
		<div class="flex-1">
			<a href="/" class="btn btn-ghost text-primary hover:bg-base-300/70 text-xl font-bold tracking-tight">Stock</a>
		</div>
		<div class="flex-none">
			<ul class="menu menu-horizontal text-base-content/75 gap-1 px-1 text-sm">
				<li><a class="hover:bg-base-300/70 hover:text-primary" href="/">Home</a></li>
				<li><a class="hover:bg-base-300/70 hover:text-primary" href="/products">Products</a></li>
				<li><a class="hover:bg-base-300/70 hover:text-primary" href="/suppliers">Suppliers</a></li>
				<li><a class="hover:bg-base-300/70 hover:text-primary" href="/categories">Categories</a></li>
				<li><a class="hover:bg-base-300/70 hover:text-primary" href="/transactions">Transactions</a></li>
				<li><a class="hover:bg-base-300/70 hover:text-primary" href="/inventory">Inventory</a></li>
			</ul>
		</div>
	</header>
}
